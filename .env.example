# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (seed, migraciones administrativas). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio corporativo permitido para el login con Google (ver lib/supabase/auth.ts y las políticas RLS)
NEXT_PUBLIC_DOMINIO_CORPORATIVO=adapsysgroup.com
